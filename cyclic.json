{
  "$schema": "https://wavefront.cyclic.sh/schema.json",
  "name": "authz-engine",
  "description": "Authorization engine (RBAC + ABAC + ReBAC) - Supabase PostgreSQL backend",
  "main": "cmd/server/main.go",
  "runtime": "golang",
  "version": "1.0.0",
  "scripts": {
    "start": "go run ./cmd/server"
  },
  "env": {
    "AUTHZ_DB_DRIVER": "postgres",
    "AUTHZ_ADDR": ":8080",
    "AUTHZ_AUTO_MIGRATE": "true",
    "AUTHZ_DB_CONN": {
      "description": "PostgreSQL connection string dari Supabase",
      "required": true,
      "type": "string",
      "example": "postgresql://postgres.abc123:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
    }
  }
}